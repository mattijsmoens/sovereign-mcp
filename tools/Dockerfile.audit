# Isolation for auditing untrusted MCP servers.
#
# `npm install` and `pip install` execute arbitrary code from the package
# (postinstall scripts, setup.py). Auditing a few hundred unvetted packages
# means running a few hundred unknown codebases, and a young, lightly reviewed
# ecosystem is exactly where someone would plant something. On a machine that
# holds PyPI tokens, GitHub credentials and signing material, that is not a
# risk worth taking for a shortlist.
#
# The container gets no host mount except a write-only output directory, runs
# as a non-root user, and is destroyed after every target.

FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip python3-venv git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# The auditor itself, installed once into the image so the per-target run only
# has to fetch the target.
# The local wheel, not PyPI: the batch has to run the scanner as it is
# now, not as it was last published. The SDK matters too - without it
# the audit command cannot speak to a server at all, which is how the
# packaging gap was found.
COPY sovereign_mcp-*.whl /tmp/
RUN python3 -m venv /opt/auditor \
 && /opt/auditor/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/auditor/bin/pip install --no-cache-dir /tmp/sovereign_mcp-*.whl "mcp>=1.29" \
 && rm -f /tmp/sovereign_mcp-*.whl

RUN useradd -m -u 10001 auditor \
 && mkdir -p /work /out \
 && chown -R auditor:auditor /work /out
USER auditor
WORKDIR /work

ENV PATH="/opt/auditor/bin:${PATH}" \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY --chown=auditor:auditor audit_one.sh /usr/local/bin/audit_one.sh
ENTRYPOINT ["/bin/bash", "/usr/local/bin/audit_one.sh"]
